{
  "name": "mini-agent",
  "version": "1.0.0",
  "description": "教学用最简 TypeScript Agent（TUI）——手写 agent loop，无重型框架",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ink": "^5.1.0",
